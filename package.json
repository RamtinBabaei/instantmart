{
  "name": "instantmart",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint app components/store lib db worker tests vite.config.ts vitest.config.ts playwright.config.ts --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write app components/store lib db worker tests docs README.md vite.config.ts vitest.config.ts playwright.config.ts",
    "format:check": "prettier --check app components/store lib db worker tests docs README.md vite.config.ts vitest.config.ts playwright.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:admin": "node scripts/promote-admin.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "types:env": "wrangler types cloudflare-env.d.ts --include-runtime=false --config dist/server/wrangler.json",
    "deploy:prepare": "node scripts/prepare-cloudflare.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/workers-types": "5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.2",
    "jsdom": "^30.1.3",
    "json-rpc-2.0": "1.7.1",
    "miniflare": "4.20260730.0",
    "prettier": "^3.9.10",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "4.151.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
